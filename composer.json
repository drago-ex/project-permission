{
	"name": "drago-ex/project-permission",
	"description": "Component for managing user permissions in a Drago project.",
	"type": "drago-tools-resource",
	"license": "MIT",
	"require": {
		"php": ">=8.3 <9",
		"nette/di": "^3.1",
		"nette/security": "^3.1",
		"nette/application": "^3.1",
		"drago-ex/component": "^3.0",
		"drago-ex/database": "^4.0",
		"drago-ex/utils": "^2.0",
		"drago-ex/application": "^4.0",
		"drago-ex/form": "^3.0",
		"drago-ex/migration": "^1.0",
		"drago-ex/permission": "^1.0",
		"drago-ex/translator": "^4.0",
		"drago-ex/project-auth": "^1.0",
		"drago-ex/project-backend": "^1.0",
		"drago-ex/datagrid": "^1.0"
	},
	"require-dev": {
		"nette/tester": "^2.5",
		"phpstan/phpstan-nette": "^2",
		"drago-ex/project-tools": "^1.0"
	},
	"extra": {
		"drago-tools": {
			"install": {
				"copy": {
					"resources/app/Presentation/Backend": "app/Presentation/Backend",
					"resources/assets/naja": "assets/naja"
				}
			},
			"migration-priority": 20
		},
		"drago-translator": {
			"translation": "app/Presentation/Backend/Permission/Translate"
		}
	},
	"scripts": {
		"phpstan": "phpstan analyse",
		"tester": "tester tests -s -C",
		"post-install-cmd": [
			"drago-install --dev",
			"drago-clean"
		],
		"post-update-cmd": [
			"drago-install --dev",
			"drago-clean"
		]
	}
}
