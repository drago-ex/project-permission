# Item of the administration menu (drago-ex/project-backend-ui merges the sidebar parameter of all packages).
parameters:
	sidebar:
		System:
			-
				title: Permissions
				link: 'Permission:*'
				icon: fa-solid fa-gear bell
				allowAny: [Backend:Permission, roles-read, users-read]
				items:
					- {title: Roles, link: 'Permission:roles', allow: [Backend:Permission, roles-read]}
					- {title: Users roles, link: 'Permission:users', allow: [Backend:Permission, users-read]}
