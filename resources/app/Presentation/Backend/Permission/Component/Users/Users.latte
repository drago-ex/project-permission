{templateType App\Presentation\Backend\Permission\Component\BaseTemplate}
{embed '../../../../Accessory/Widget/@offcanvas.latte', offcanvasId: $offcanvasId, size: '61rem'}
	{block title}{_'Manage User Roles'}{/block}
	{block body}
		{snippet offcanvas}
			{embed '../../../../Accessory/Widget/@form.latte', class: 'ajax', name: 'users', najaHistory: 'off'}
				{import '../../../../Accessory/Widget/@dismiss-button.latte'}
				{block form}
					{* the user is shown readonly, only the roles change *}
					{include input, name: 'userName'}
					{* several roles at once: Tom Select of drago-ex/form; none leaves the default role "user" *}
					{include input, type: 'select', name: 'roles', class: 'select-tom'}
					<div class="col-12">
						{include buttonDismiss, type: 'offcanvas'}
						{include submit, name: 'send'}
					</div>
				{/block}
			{/embed}
		{/snippet}
	{/block}
{/embed}

{embed '../../../../Accessory/Widget/@modal.latte', modalId: $modalId, options: [header: 'danger']}
	{block title}{_'Confirm delete'}{/block}
	{block body}
		{snippet content}
			{include '../@modal-body.latte'}
		{/snippet}
	{/block}
	{block footer}
		{snippet modal}
			{include '../@modal-footer.latte'}
		{/snippet}
	{/block}
{/embed}

{embed '../@datagrid-heading.latte', addButton: false}
	{block title}
		{_'Users data'}
	{/block}
	{block subtitle}
		{_'Assign roles to the users; a user without a role has the role user.'}
	{/block}
	{block buttons}
		<a n:if="$user->isAllowed('Backend:Permission', 'roles')" href="{plink :Backend:Permission:roles}" class="btn btn-secondary btn-sm">{_'Roles'}</a>
	{/block}
{/embed}

{control dataGrid}
