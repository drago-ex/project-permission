{templateType App\Presentation\Backend\Permission\Component\BaseTemplate}
{embed '../../../../Accessory/Widget/@offcanvas.latte', offcanvasId: $offcanvasId, size: '61rem'}
	{block title}{_'Manage User Roles'}{/block}
	{block body}
		{snippet offcanvas}
			{embed '../../../../Accessory/Widget/@form.latte', class: 'ajax', name: 'users', najaHistory: 'off'}
				{import '../../../../Accessory/Widget/@dismiss-button.latte'}
				{block form}
					{* an edit changes only the roles: the user is shown readonly, the select is not sent *}
					{if (int) $form['id']->getValue() > 0}
						{include input, name: 'userName'}
					{else}
						{include input, type: 'select', name: 'userId'}
					{/if}
					{* several roles at once: Tom Select of drago-ex/form *}
					{include input, type: 'select', name: 'roleId', class: 'select-tom'}
					<div class="col-12">
						{include buttonDismiss, type: 'offcanvas'}
						{include submit, name: 'send'}
					</div>
				{/block}
			{/embed}
		{/snippet}
	{/block}
{/embed}

{embed '../../../../Accessory/Widget/@modal.latte', modalId: $modalId, options: [header: 'danger']}
	{block title}{_'Confirm delete'}{/block}
	{block body}
		{snippet content}
			{include '../@modal-body.latte'}
		{/snippet}
	{/block}
	{block footer}
		{snippet modal}
			{include '../@modal-footer.latte'}
		{/snippet}
	{/block}
{/embed}

{embed '../@datagrid-heading.latte', access: $writeAllowed}
	{block title}
		{_'Users data'}
	{/block}
	{block buttons}
		<a n:if="$user->isAllowed('Backend:Permission', 'roles-read')" href="{plink :Backend:Permission:roles}" class="btn btn-secondary btn-xs">{_'Roles'}</a>
	{/block}
{/embed}

{control dataGrid}
