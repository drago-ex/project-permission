{default bool $access = false}
<h5 class="border-bottom pb-2 d-flex align-items-center gap-2">
	<span class="me-auto">{block title}{/block}</span>
	{* links of the page, e.g. to the roles *}
	{block buttons}{/block}
	<a n:if="$access" n:href="openOffcanvas!" class="btn btn-primary btn-xs ajax" data-naja-history="off">
		{_'Add item'}
	</a>
</h5>
