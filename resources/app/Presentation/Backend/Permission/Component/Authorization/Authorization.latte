{templateType App\Presentation\Backend\Permission\Component\Authorization\AuthorizationTemplate}

{* the privileges of a role, opened by the shield of the roles grid; every signal redraws only the snippet *}
{embed '../../../../Accessory/Widget/@offcanvas.latte', offcanvasId: $offcanvasId, size: '72rem', role: $role, roleName: $roleName,
	groups: $groups, resource: $resource, resourceAllowed: $resourceAllowed, allowedCount: $allowedCount,
	deniedCount: $deniedCount, isAdminRole: $isAdminRole, writeAllowed: $writeAllowed}
	{block title}{_'Role permissions'}{/block}
	{block body}
		{snippet permissions}
			{if $role !== ''}

			{* the role and the numbers of its privileges *}
			<header class="mb-4 d-flex flex-wrap justify-content-between align-items-center gap-3">
				<div class="d-flex flex-wrap align-items-baseline column-gap-2">
					<h2 class="h5 mb-0">{$roleName}</h2>
					<span class="text-body-secondary">{$role}</span>
				</div>
				<div class="d-flex flex-wrap align-items-center gap-2">
					<span class="badge badge-subtle theme-success">{_'Allowed'}: {$allowedCount}</span>
					<span class="badge badge-subtle theme-danger">{_'Denied'}: {$deniedCount}</span>
				</div>
			</header>

			{* admin notice *}
			<div n:if="$isAdminRole" class="alert alert-warning d-flex align-items-center gap-2 mb-3">
				<i class="bi bi-shield-check" aria-hidden="true"></i>
				{_'Administrator role has full access granted by default. These settings have no effect.'}
			</div>

			{* permissions: the presenters on the left, the privileges of the selected one on the right *}
			{if $groups}
				<div class="row g-4">

					{* presenters: a list in a box (nav-list of the compostrap module settings), the allowed of all on the right *}
					<div class="col-md-4">
						<nav class="nav-list nav-list-box" aria-label="{_'Presenters'}">
							{foreach $groups as $name => $items}
								<a n:href="resource!, role: $role, resource: $name" data-naja-history="off"
									n:class="'ajax', 'nav-list-link', $name === $resource ? 'active'"
									n:attr="aria-current: $name === $resource ? 'true'">
									<span class="text-truncate">{$name}</span>
									<span class="nav-list-count">{$resourceAllowed[$name] ?? 0}/{$items|length}</span>
								</a>
							{/foreach}
						</nav>
					</div>

					{* privileges of the selected presenter *}
					<div class="col-md-8">
						{var $items = $groups[$resource]}
						{* the kinds of places of the code that need a privilege, each with its color *}
						{var $kinds = [
							Drago\Permission\PrivilegeCatalog::Page => ['Page', 'primary'],
							Drago\Permission\PrivilegeCatalog::Signal => ['Action', 'warning'],
							Drago\Permission\PrivilegeCatalog::Form => ['Form', 'info'],
						]}

						<div class="setting-list">
							<div class="d-flex flex-wrap align-items-baseline justify-content-between gap-2 mb-2">
								<h3 class="h6 mb-0">{$resource}</h3>
								<span class="text-body-secondary">{$items|length} {_'permissions'}</span>
							</div>

							{foreach $items as $item}
								{var $inputId = "permission-{$role}-{$resource}-{$item['privilege']}"}

								{* one row: the privilege with labels of the places of the code that need it (their names in
								   the tooltip), its description and the switch *}
								<div class="setting-row">
									<div class="setting-row-text">
										<div class="d-flex flex-wrap align-items-center gap-2">
											<span class="fw-medium text-body-emphasis">{$item['privilege']}</span>
											{foreach $kinds as $kind => [$kindLabel, $kindColor]}
												<span n:ifset="$item['sources'][$kind]" class="badge badge-subtle theme-{$kindColor}"
													data-tooltip aria-label="{_$kindLabel}: {implode(', ', $item['sources'][$kind])}">{_$kindLabel}</span>
											{/foreach}
										</div>
										<div n:if="$item['label'] !== null" class="text-body-secondary">{_$item['label']}</div>
									</div>

									{if $item['inherited']}
										{* a privilege of the neon files or of a parent role cannot be denied here: a lock instead
										   of a switch, the reason in its tooltip *}
										<div class="setting-row-control">
											<span class="setting-row-locked" tabindex="0" data-tooltip="left"
												aria-label="{_'Allowed by the ACL or a parent role, change it there.'}"><i class="bi bi-lock" aria-hidden="true"></i>{_'Inherited'}</span>
										</div>
									{else}
										{* the switch saves at once (PermissionToggle); the administrator and a user without
										   the privilege "edit" only see the state *}
										{var $isLocked = $isAdminRole || !$writeAllowed}
										<div class="setting-row-control form-check form-switch">
											<input
												type="checkbox"
												role="switch"
												id="{$inputId}"
												data-naja-history="off"
												autocomplete="off"
												data-url="{link togglePermission!, role: $role, resource: $resource, privilege: $item['privilege']}"
												n:class="'form-check-input', !$isLocked ? 'js-permission-toggle'"
												n:attr="checked: $item['allowed'], disabled: $isLocked">
											<label class="form-check-label" for="{$inputId}">
												{if $item['allowed']}{_'Allowed'}{else}{_'Denied'}{/if}
											</label>
										</div>
									{/if}
								</div>
							{/foreach}
						</div>
					</div>
				</div>

			{else}

				{* empty state *}
				<div class="py-5 text-center text-body-secondary">{_'No permissions found'}</div>

			{/if}
			{/if}
		{/snippet}
	{/block}
{/embed}
