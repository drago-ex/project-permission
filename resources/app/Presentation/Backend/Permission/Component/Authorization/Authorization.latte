{templateType App\Presentation\Backend\Permission\Component\Authorization\AuthorizationTemplate}

{snippet permissions}

	{* header *}
	<header class="mb-4 pb-2 border-bottom d-flex flex-wrap justify-content-between align-items-end gap-3">

		{* title *}
		<div>
			<h1 class="h5 mb-1">{_'Role permissions'}</h1>
			<p class="small text-body-secondary mb-0">
				{_'Setting access for the selected role'}
			</p>
		</div>

		<div class="d-flex align-items-center gap-2">

			{* role switch *}
			<form action="{plink this}" method="get" class="d-flex align-items-center gap-2 mb-0">
				<label for="role-switch" class="small text-body-secondary">
					{_'Role'}
				</label>

				<select name="authorization-role" id="role-switch" class="form-select form-select-sm" onchange="this.form.submit()">
					<option value="" n:attr="selected: $role === ''">{_'Select role'}</option>
					{foreach $roles as $name => $label}
						<option value="{$name}" n:attr="selected: $name === $role">
							{$label}
						</option>
					{/foreach}
				</select>

				{* hidden submit, triggers form on select change *}
				<button type="submit" class="visually-hidden">
					{_'Apply'}
				</button>
			</form>

			{* permission counters *}
			<span class="badge border border-success-subtle text-success px-3 py-2">
				({$allowedCount}) {_'Allowed'}
			</span>
			<span class="badge border border-danger-subtle text-danger px-3 py-2">
				({$deniedCount}) {_'Denied'}
			</span>
		</div>
	</header>

	{* admin notice *}
	{if $isAdminRole}
		<div class="alert alert-warning d-flex align-items-center gap-2 py-2 px-3 mb-3 small">
			<i class="fa fa-shield-halved"></i>
			{_'Administrator role has full access granted by default. These settings have no effect.'}
		</div>
	{/if}

	{* permissions list, by presenter *}
	<div class="card-body">
		<div class="d-flex flex-column gap-3">
			{foreach $groups as $resource => $items}

				{* resource group *}
				<div class="overflow-hidden">

					{* resource header *}
					<div class="authorization-resource-header px-4 py-2 rounded">
						<div class="fw-semibold text-body-emphasis">{$resource}</div>
						<div class="small text-body-secondary">
							{$items|length} {_'permissions'}
						</div>
					</div>

					<div class="list-group list-group-flush">
						{foreach $items as $item}
							{var $inputId = "permission-{$role}-{$resource}-{$item['privilege']}"}
							{* a privilege of the neon files or of a parent role cannot be denied here, it is shown as inherited *}
							{var $isLocked = $isAdminRole || $item['inherited'] || !$writeAllowed}

							<div n:class="'list-group-item', 'authorization-permission-item', 'px-3', $iterator->isLast() ? 'pt-1 pb-3' : 'pt-2 pb-0 border-bottom-0'">
								<div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-2">

									{* privilege *}
									<div class="min-w-0 small">
										<span class="fw-semibold text-body-emphasis">{$item['privilege']}</span>
									</div>

									{* permission toggle *}
									<div class="d-flex align-items-center gap-2 flex-shrink-0">
										<input
											type="checkbox"
											id="{$inputId}"
											data-naja-history="off"
											autocomplete="off"
											data-url="{link togglePermission!, role: $role, resource: $resource, privilege: $item['privilege']}"
											n:class="'btn-check', !$isLocked ? 'js-permission-toggle'"
											n:attr="checked: $item['allowed'], disabled: $isLocked">

										<label for="{$inputId}" n:class="'btn', 'btn-sm', 'px-3', 'fw-semibold', 'rounded-pill', $item['allowed'] ? 'btn-success' : 'btn-danger'"
											n:attr="title: $item['inherited'] ? ('Allowed by the ACL or a parent role, change it there.'|translate)">
											{if $item['inherited']}{_'Allowed (inherited)'}{elseif $item['allowed']}{_'Allowed'}{else}{_'Denied'}{/if}
										</label>
									</div>

								</div>
							</div>
						{/foreach}
					</div>
				</div>

			{else}

				{* empty state *}
				<div class="px-4 py-5 text-center text-body-secondary bg-body-tertiary border rounded-3">
					{if $role === ''}{_'Select a role to set its permissions.'}{else}{_'No permissions found'}{/if}
				</div>

			{/foreach}
		</div>
	</div>

{/snippet}
